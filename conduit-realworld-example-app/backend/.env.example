## Environment Variables
PORT=3001
JWT_KEY=supersecretkey_example
# Run sequelize.sync({ alter: true }) on startup. Development only; deployed
# environments leave this unset and run migrations (npm run db:migrate -w backend).
DB_SYNC=true
# Comma-separated allowed origins. Unset allows any origin. Not needed when
# CloudFront serves the frontend and /api/* from the same domain.
CORS_ORIGIN=
# When set, /api/* requires a matching X-Origin-Verify header (added by
# CloudFront as an origin custom header). Leave unset locally.
ORIGIN_VERIFY_SECRET=

## Development Database
DEV_DB_USERNAME=root
DEV_DB_PASSWORD=null
DEV_DB_NAME=database_development
DEV_DB_HOSTNAME=127.0.0.1
DEV_DB_PORT=3306
DEV_DB_DIALECT=mysql
DEV_DB_LOGGING=true

## Testing Database
TEST_DB_USERNAME=root
TEST_DB_PASSWORD=null
TEST_DB_NAME=database_testing
TEST_DB_HOSTNAME=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_DIALECT=mysql
TEST_DB_LOGGING=true

## Production Database
PROD_DB_USERNAME=root
PROD_DB_PASSWORD=null
PROD_DB_NAME=database_production
PROD_DB_HOSTNAME=127.0.0.1
PROD_DB_PORT=3306
PROD_DB_DIALECT=mysql
PROD_DB_LOGGING=false