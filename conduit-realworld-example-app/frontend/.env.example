# Base URL of the backend API, baked in at build time.
# Leave empty to call /api/* on the same origin (CloudFront routes it to the
# ALB in production; the Vite dev/preview proxy forwards it to localhost:3001).
# Set it (e.g. https://api.example.com) only when the API lives on another host,
# and add that frontend origin to the backend's CORS_ORIGIN.
VITE_API_URL=
